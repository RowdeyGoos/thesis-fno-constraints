Bootstrap: docker
From: python:3.10-slim

%files
    requirements.txt /workspace/requirements.txt
    train.py         /workspace/train.py
    eval.py          /workspace/eval.py
    models           /workspace/models
    utils            /workspace/utils
    config           /workspace/config

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    export PIP_ROOT_USER_ACTION=ignore

    # System dependencies
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        wget \
        vim \
        openmpi-bin \
        libopenmpi-dev \
        ca-certificates \
        patchelf
    rm -rf /var/lib/apt/lists/*

    # Upgrade pip
    python -m pip install --upgrade pip

    # PyTorch 1.12.0 + CUDA 11.3
    python -m pip install --no-cache-dir \
        torch==1.12.0+cu113 \
        torchvision==0.13.0+cu113 \
        -f https://download.pytorch.org/whl/torch_stable.html

    # Clear executable-stack flag on libtorch_cpu.so (glibc 2.41+ workaround)
    TORCH_LIB="/usr/local/lib/python3.10/site-packages/torch/lib/libtorch_cpu.so"
    if [ -f "$TORCH_LIB" ]; then
        patchelf --clear-execstack "$TORCH_LIB" || true
    fi

    # Project requirements (torch / torchvision must NOT be in requirements.txt)
    python -m pip install --no-cache-dir -r /workspace/requirements.txt

    # Project dirs
    mkdir -p /workspace/data
    mkdir -p /workspace/experiments

%environment
    export PYTHONPATH=/workspace:$PYTHONPATH
    export PYTHONUNBUFFERED=1
    export OMP_NUM_THREADS=1

%runscript
    exec /bin/bash "$@"

%labels
    Author TU Delft
    Version 1.0
    Description Neural Operators Transfer Learning Scaling Container (Py3.10, torch 1.12.0+cu113)

%test
    echo "Skipping heavy tests at build time; test torch import at runtime."
